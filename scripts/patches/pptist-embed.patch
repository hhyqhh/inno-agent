new file mode 100644
--- /dev/null
+++ b/src/embed.ts
@@ -0,0 +1,58 @@
+/** Same-origin embed bridge. Import completion comes from the importer. */
+import useImport from '@/hooks/useImport'
+import useExport from '@/hooks/useExport'
+import { useSlidesStore } from '@/store'
+import { watch } from 'vue'
+import { nanoid } from 'nanoid'
+
+declare global {
+  interface Window { __pptistCaptureExport?: (blob: Blob) => void; __pptistExportError?: (error: unknown) => void }
+}
+export function setupEmbed() {
+  const params = new URLSearchParams(location.search)
+  if (!params.has('embed')) return
+  const origin = window.location.origin
+  let loaded = false
+  let importing = false
+  const send = (data: Record<string, unknown>, transfer: Transferable[] = []) => window.parent.postMessage(data, origin, transfer)
+  const store = useSlidesStore()
+  store.setSlides([{ id: nanoid(10), elements: [] }])
+  // Immediate mutation reporting avoids the old 2.5s/800ms blind windows,
+  // where early edits or an immediate tab close silently lost a draft.
+  watch(() => [store.slides, store.theme, store.viewportSize, store.viewportRatio], () => {
+    if (loaded && !importing) send({ type: 'pptist:change' })
+  }, { deep: true, flush: 'sync' })
+  window.addEventListener('message', (event) => {
+    if (event.origin !== origin || event.source !== window.parent) return
+    const data = event.data
+    if (!data || typeof data !== 'object') return
+    if (data.type === 'pptist:load' && data.buffer instanceof ArrayBuffer && !importing) {
+      importing = true
+      loaded = false
+      const file = new File([data.buffer], data.name || 'deck.pptx')
+      useImport().importPPTXFile([file], {
+        cover: true,
+        onComplete: () => { importing = false; loaded = true; send({ type: 'pptist:loaded' }) },
+        onError: (error) => { importing = false; send({ type: 'pptist:error', error: String(error) }) },
+      })
+    }
+    if (data.type === 'pptist:export' && loaded && !window.__pptistCaptureExport) {
+      const requestId = data.requestId
+      window.__pptistExportError = (error) => {
+        window.__pptistCaptureExport = undefined
+        window.__pptistExportError = undefined
+        send({ type: 'pptist:error', requestId, error: String(error) })
+      }
+      window.__pptistCaptureExport = (blob) => {
+        window.__pptistCaptureExport = undefined
+        blob.arrayBuffer().then((buffer) => {
+          window.__pptistExportError = undefined
+          send({ type: 'pptist:exported', requestId, buffer }, [buffer])
+        }).catch((error) => window.__pptistExportError?.(error))
+      }
+      try { useExport().exportPPTX(store.slides, true, false) }
+      catch (error) { window.__pptistExportError?.(error) }
+    }
+  })
+  send({ type: 'pptist:ready' })
+}
