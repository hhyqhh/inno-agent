new file mode 100644
index 0000000..9d9404d
--- /dev/null
+++ b/src/embed.ts
@@ -0,0 +1,62 @@
+/** Same-origin embed bridge. Import completion comes from the importer. */
+import useImport from '@/hooks/useImport'
+import useExport from '@/hooks/useExport'
+import { useSlidesStore } from '@/store'
+import { watch } from 'vue'
+import { nanoid } from 'nanoid'
+
+export function setupEmbed() {
+  const params = new URLSearchParams(location.search)
+  if (!params.has('embed')) return
+  const origin = window.location.origin
+  let loaded = false
+  let importing = false
+  const send = (data: Record<string, unknown>, transfer: Transferable[] = []) => window.parent.postMessage(data, origin, transfer)
+  const store = useSlidesStore()
+  const snapshot = () => JSON.parse(JSON.stringify({ slides: store.slides, theme: store.theme, viewportSize: store.viewportSize, viewportRatio: store.viewportRatio }))
+  store.setSlides([{ id: nanoid(10), elements: [] }])
+  // Immediate mutation reporting avoids the old 2.5s/800ms blind windows,
+  // where early edits or an immediate tab close silently lost a draft.
+  watch(() => [store.slides, store.theme, store.viewportSize, store.viewportRatio], () => {
+    if (loaded && !importing) send({ type: 'pptist:change' })
+  }, { deep: true, flush: 'sync' })
+  window.addEventListener('keydown', (event) => {
+    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 's') {
+      event.preventDefault()
+      send({ type: 'pptist:save-request' })
+    }
+  }, true)
+  window.addEventListener('message', async (event) => {
+    if (event.origin !== origin || event.source !== window.parent) return
+    const data = event.data
+    if (!data || typeof data !== 'object') return
+    if (data.type === 'pptist:load' && data.buffer instanceof ArrayBuffer && !importing) {
+      importing = true
+      loaded = false
+      const file = new File([data.buffer], data.name || 'deck.pptx')
+      useImport().importPPTXFile([file], {
+        cover: true,
+        onComplete: () => {
+          // Keep original text boxes fixed: automatic DOM measurement otherwise
+          // changes geometry merely by mounting the incomplete imported view.
+          for (const slide of store.slides) for (const el of slide.elements) if (el.type === 'text') el.fixedHeight = true
+          importing = false
+          loaded = true
+          send({ type: 'pptist:loaded', snapshot: snapshot() })
+        },
+        onError: (error) => { importing = false; send({ type: 'pptist:error', error: String(error) }) },
+      })
+    }
+    if (data.type === 'pptist:export' && loaded) {
+      // Use the same complete exporter as PPTist's standalone editor.
+      // Return bytes to the host; only the host writes workspace files.
+      try {
+        const buffer = await useExport().exportPPTX(store.slides, false, false, true)
+        if (!(buffer instanceof ArrayBuffer)) throw new Error('Invalid PPTX export')
+        send({ type: 'pptist:exported', requestId: data.requestId, buffer }, [buffer])
+      }
+      catch (error) { send({ type: 'pptist:error', requestId: data.requestId, error: String(error) }) }
+    }
+  })
+  send({ type: 'pptist:ready' })
+}
